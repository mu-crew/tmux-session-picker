    "base": "#1e1e2e",
}
# THEME END: tsesh-palette

# (foreground, bold) per row state. Working and waiting keep the kind colour.
STATE_STYLE: dict[AgentState | None, tuple[str, bool]] = {
    AgentState.crashed: (CATPPUCCIN["red"], True),
    AgentState.error: (CATPPUCCIN["maroon"], True),
    AgentState.blocked: (CATPPUCCIN["peach"], True),
    AgentState.done: (CATPPUCCIN["teal"], False),
}
KIND_FG: dict[str, str] = {
    "default": CATPPUCCIN["lavender"],
    "tmux": CATPPUCCIN["sky"],
    "zoxide": CATPPUCCIN["sapphire"],
    "find": CATPPUCCIN["subtext0"],
    "agent": CATPPUCCIN["lavender"],
}

FZF_BORDER_LABEL = " sessions "
UNDERLINE = "\x1b[4m"
RESET = "\x1b[0m"


class ConfigError(ValueError):
    pass


@dataclass(frozen=True)
class SessionConfig:
    name: str
    path: str
    startup: str = ""
    split: str = DEFAULT_SPLIT


@dataclass(frozen=True)
class Config:
    sessions: tuple[SessionConfig, ...]
    blacklist: frozenset[str]
    noisy_basenames: frozenset[str]
    find_max_depth: int
    preview_command: str
    # When the picker is launched in `all` mode and the number of live tmux
    # sessions is >= this threshold, the initial view auto-switches to `sessions`
    # (pinned and live). 0 disables the auto-switch. The fzf reload binds
    # (^a/^s/^f) are unaffected; the user can still pull up the merged
    # view with ^a after the picker is open.
    live_session_threshold: int = 0
    # Pass `--exact` to fzf so query tokens match as literal substrings
    # instead of fzf's default scattered-character fuzzy. Prefix a token
    # with `'` to escape back to fuzzy for that token. Default true keeps
    # the strict behavior; flip to false in the config for classic fuzzy.
    fzf_exact: bool = True


# Picker-row schema. The first field is the rendered (ANSI-styled) display
# text fzf shows; the rest are payload fields parsed back out of the
# selected row. Reordering or adding to this list updates both `to_fzf_row`
# and `from_fzf_row` at once, so the producer and consumer can never drift.
FZF_ROW_FIELDS: tuple[str, ...] = (
    "display",  # synthetic: rendered text from visible_text()
    "kind",
    "session_name",
    "path",
    "startup",
    "split",
    "host",  # agent rows: murmur host name
    "pane",  # agent rows: tmux pane id
    "jump_target",  # agent rows: murmur's opaque token for `murmur jump`
    "here",  # agent rows: "1" when the pane is on the tmux server tsesh talks to
    "socket",  # agent rows: the socket that proof was made against
    "session_id",  # live session rows: tmux's $N id, the only exact kill target
)


# First column of every row: where the invoking client is, and sessions other
# clients have attached.
CURRENT_MARK = "◆"
ATTACHED_MARK = "◇"


def marker_cell(marker: str) -> str:
    if marker == "current":
        return ansi_style(CURRENT_MARK, fg=CATPPUCCIN["text"], bold=True)
    if marker == "attached":
        return ansi_style(ATTACHED_MARK, fg=CATPPUCCIN["overlay0"])
    return " "


ROW_ESCAPES = {"\\": "\\\\", "\t": "\\t", "\r": "\\r", "\n": "\\n"}
ROW_UNESCAPES = {v[1]: k for k, v in ROW_ESCAPES.items()}


def row_escape(value: str) -> str:
    """One picker-row field with no tab, CR or LF left in it: a tab would
    shift every later field, a line break would split the row."""
    return re.sub(r"[\\\t\r\n]", lambda m: ROW_ESCAPES[m[0]], value)


def row_unescape(value: str) -> str:
    """Undo row_escape, for a field read back from a row or an fzf {N}."""
    return re.sub(r"\\(.)", lambda m: ROW_UNESCAPES.get(m[1], m[0]), value, flags=re.S)


def counts_cell(windows: int, panes: int) -> str:
    """Window and pane counts ("3w 5p"); just the windows when both do not fit."""
    both = f"{windows}w {panes}p"
    if len(both) <= COUNTS_WIDTH:
        return both
    return f"{windows}w" if windows <= 99 else "99+w"


def state_cell(
    counts: tuple[tuple[AgentState, int], ...], width: int = STATE_WIDTH
) -> str:
    """Per-state agent counts, strongest first, within WIDTH.

    No state vanishes silently: groups that do not fit collapse into "+N", the
    number of agents they hold. A count above 99 reads "99+".
    """
    groups = [f"{STATE_GLYPH[st]}{n if n <= 99 else '99+'}" for st, n in counts]
    if len(" ".join(groups)) <= width:
        return " ".join(groups)
    for keep in range(len(groups) - 1, -1, -1):
        rest = sum(n for _, n in counts[keep:])
        cell = " ".join([*groups[:keep], f"+{rest}"])
        if len(cell) <= width:
            return cell
    return f"+{sum(n for _, n in counts)}"


@dataclass(frozen=True)
class Entry:
    kind: str
    name: str
    session_name: str
    path: str = ""
    startup: str = ""
    split: str = ""
    worst_state: AgentState | None = None
    is_running: bool = False
    # murmur's per-state agent counts for a session row, strongest first.
    agent_counts: tuple[tuple[AgentState, int], ...] = ()
    host: str = ""
    pane: str = ""
    jump_target: str = ""
    here: str = ""
    socket: str = ""
    detail: str = ""  # shown where a path would be (agent rows)
    marker: str = ""  # "current", "attached" or "": see marker_cell
    text: str = ""  # pre-rendered columns (agents view); replaces the layout
    extra: str = ""  # dim note after the path ("+2": windows in other dirs)
    counts: str = ""  # live sessions: counts_cell
    session_id: str = ""

    @property
    def icon(self) -> str:
        return KIND_ICON[self.kind]

    @property
    def display_path(self) -> str:
        if self.detail:
            return self.detail
        if not self.path:
            return ""
        return tildify(self.path)

    def visible_text(self) -> str:
        note = self.extra
        if self.text:
            text = self.text
        else:
            layout = LAYOUT
            # Text is escaped before it is fitted: the escaped form is what
            # fzf shows, so that is what must fit (see to_fzf_row).
            name = fit(row_escape(self.name), layout.name_width, keep="middle")
            ws = self.worst_state
            if self.agent_counts:
                cell = state_cell(self.agent_counts, layout.state_width)
            else:
                cell = STATE_GLYPH[ws] if ws is not None else " "
            text = f"{self.icon} {name} {fit(cell, layout.state_width)} "
            if layout.show_counts:
                text += fit(self.counts, COUNTS_WIDTH) + " "
            room = layout.path_width - (len(note) + 1 if note else 0)
            if not layout.path_width or room < 4:
                note = ""
            room = layout.path_width - (len(note) + 1 if note else 0)
            if self.display_path and room > 0:
                text += fit(row_escape(self.display_path), room, keep="start")
            text = text.rstrip()
        dim = " " + ansi_style(note, fg=CATPPUCCIN["overlay0"]) if note else ""
        return marker_cell(self.marker) + self.styled(text) + dim

    def styled(self, text: str) -> str:
        # Agent states win over the kind colour: a blocked or crashed agent
        # must still show when the session is also pinned or live.
        if style := STATE_STYLE.get(self.worst_state):
            fg, bold = style
            return ansi_style(text, fg=fg, bg=CATPPUCCIN["surface0"], bold=bold)
        style_kind = "tmux" if self.kind == "default" and self.is_running else self.kind
        fg = KIND_FG.get(style_kind)
        if fg is None:
            return text
        return ansi_style(text, fg=fg)

    def to_fzf_row(self) -> str:
        values = {
            "display": self.visible_text(),
            "kind": self.kind,
            "session_name": self.session_name,
            "path": self.path,
            "startup": self.startup,
            "split": self.split,
            "host": self.host,
            "pane": self.pane,
            "jump_target": self.jump_target,
            "here": self.here,
            "socket": self.socket,
            "session_id": self.session_id,
        }
        # The display is escaped piece by piece in visible_text, before its
        # columns are fitted; escaping it again would widen it past the list.
        return "\t".join(
            values[name] if name == "display" else row_escape(values[name])
            for name in FZF_ROW_FIELDS
        )

    @classmethod
    def from_fzf_row(cls, row: str) -> dict[str, str]:
        """Parse a tab-joined picker row back into a ``{field: value}`` dict.

        Returns a dict rather than an ``Entry`` because the rendered display
        text is one-way (ANSI styled) and downstream consumers only need the
        payload fields. Raises ``ConfigError`` on field-count mismatch so
        schema drift fails loudly in one place.
        """
        parts = row.split("\t")
        if len(parts) != len(FZF_ROW_FIELDS):
            raise ConfigError(
                f"Invalid picker row: expected {len(FZF_ROW_FIELDS)} "
                f"tab-separated fields, got {len(parts)}"
            )
        fields = dict(zip(FZF_ROW_FIELDS, parts, strict=True))
        # The display is stored as shown (see to_fzf_row); the rest unescape.
        return {k: v if k == "display" else row_unescape(v) for k, v in fields.items()}


@dataclass(frozen=True)
class EntryPayload:
    """Typed view of the fields that survive an Entry's fzf round-trip.

    ``Entry`` carries display-only fields (icon, is_running, rendered
    text) that aren't worth re-deriving on selection. Anything the
    ``connect_*`` path actually needs lives here, so consumers don't have
    to reach into the dict-shaped output of :meth:`Entry.from_fzf_row`.
    """

    session_name: str
    kind: str = ""
    path: str | None = None
    startup: str | None = None
    split: str = DEFAULT_SPLIT
    host: str = ""
    pane: str = ""
    jump_target: str = ""
    here: str = ""
    socket: str = ""

    @classmethod
    def from_fzf_row(cls, row: str) -> EntryPayload:
        fields = Entry.from_fzf_row(row)
        return cls(
            session_name=fields["session_name"],
            kind=fields["kind"],
            path=fields["path"] or None,
            startup=fields["startup"] or None,
            split=fields["split"] or DEFAULT_SPLIT,
            host=fields["host"],
            pane=fields["pane"],
            jump_target=fields["jump_target"],
            here=fields["here"],
            socket=fields["socket"],
        )


def ansi_style(
    text: str, *, fg: str | None = None, bg: str | None = None, bold: bool = False
) -> str:
    parts: list[str] = []
    if bold:
        parts.append("1")
    if fg:
        parts.append(f"38;2;{int(fg[1:3], 16)};{int(fg[3:5], 16)};{int(fg[5:7], 16)}")
    if bg:
        parts.append(f"48;2;{int(bg[1:3], 16)};{int(bg[3:5], 16)};{int(bg[5:7], 16)}")
    if not parts:
        return text
    return f"\x1b[{';'.join(parts)}m{text}\x1b[0m"


def run(
    cmd: list[str], *, check: bool = True, capture: bool = True
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, check=check, text=True, capture_output=capture)


def exact_session_target(name: str) -> str:
    return f"={name}"


def exact_pane_target(name: str, pane: str) -> str:
    return f"={name}:{pane}"


def active_pane_target(name: str) -> str:
    """The session's current window and active pane, whatever the base-index."""
    return f"={name}:"


def tildify(path: str) -> str:
    """Rewrite a leading home directory as ``~``; nothing else."""
    home = str(Path.home()).rstrip("/")
    if path == home:
        return "~"
    if home and path.startswith(home + "/"):
        return "~" + path[len(home) :]
    return path


def expand(path: str) -> str:
    return str(Path(path).expanduser())


# Which row kind's icon marks each non-"all" view.
MODE_KIND = {"sessions": "tmux", "find": "find", "agents": "agent"}

# Leads the prompt while orchestrated (crew) agents are shown. The prompt is
# the toggle's only state: fzf hands it to a binding as $FZF_PROMPT, so it
# survives view switches (see fzf_action).
CREW_MARK = "crew "

# Prompt colour per state for the agents view's counts.
COUNT_FG: dict[AgentState, str] = {
    **{state: fg for state, (fg, _) in STATE_STYLE.items() if state is not None},
    AgentState.working: CATPPUCCIN["sky"],
    AgentState.waiting: CATPPUCCIN["lavender"],
    AgentState.idle: CATPPUCCIN["overlay0"],
}


def mode_glyph(mode: str) -> str:
    # "all" is a synthetic mode that doesn't appear in KIND_ICON; the rest
    # share their glyph with the per-entry kind icon for visual consistency.
    return ">" if mode == "all" else KIND_ICON[MODE_KIND[mode]]


def prompt_text(
    mode: str, crew: bool = False, counts: Mapping[AgentState, int] | None = None
) -> str:
    """The prompt: crew mark, view glyph, and in the agents view the number of
    shown agents per state, strongest first."""
    mark = CREW_MARK if crew else ""
    shown = sorted((counts or {}).items(), key=lambda item: -item[0])
    groups = " ".join(
        ansi_style(f"{STATE_GLYPH[st]}{n}", fg=COUNT_FG[st]) for st, n in shown if n
    )
    return f"{mark}{mode_glyph(mode)} {groups}{' ' if groups else ''} "


def prompt_state(prompt: str) -> tuple[str, bool]:
    """The (view, crew) a prompt built by prompt_text encodes."""
    crew = prompt.startswith(CREW_MARK)
    glyph = prompt.removeprefix(CREW_MARK)[:1]
    views = {mode_glyph(mode): mode for mode in MODES}
    return views.get(glyph, "all"), crew


@dataclass(frozen=True)
class AgentColumns:
    stream: bool = False
    host: bool = False


def header_text(
    mode: str = "all",
    *,
    notice: str = "",
    status: str = "",
    columns: AgentColumns | None = None,
) -> str:
    """Header lines: murmur's session notice when a peer needs one, the key
    legend, a status line (empty view, murmur missing), the column titles."""
    items = [
        ("all", "^a all"),
        ("sessions", "^s sessions"),
        ("agents", "^g crew" if mode == "agents" else "^g agents"),
        ("find", "^f find"),
    ]
    legend = [
        (label, CATPPUCCIN["sky" if view == mode else "subtext0"])
        for view, label in items
    ]
    legend.append(("^x kill", CATPPUCCIN["subtext0"]))
    if LAYOUT.preview == "hidden":
        legend.append(("^/ preview", CATPPUCCIN["subtext0"]))
    legend += [
        (label, CATPPUCCIN["overlay0"]) for label in ("tab/s-tab move", "enter open")
    ]
    lines = [notice] if notice else []
    lines += legend_lines(legend, LAYOUT.row_width - 2)
    if status:
        lines.append("  " + status)
    nw = LAYOUT.name_width
    if mode == "agents":
        stream, host = LAYOUT.agent_columns(
            *(astuple(columns) if columns else (False, False))
        )
        titles = "   " + fit("agent", nw)
        if stream:
            titles += " " + fit("stream", STREAM_WIDTH)
        if host:
            titles += " " + fit("host", HOST_WIDTH)
        titles += " age"
    else:
        titles = f"   {fit('session', nw)} {fit('state', LAYOUT.state_width)} "
        if LAYOUT.show_counts:
            titles += fit("windows", COUNTS_WIDTH) + " "
        if LAYOUT.path_width:
            titles += "path"
    lines.append(f"{UNDERLINE}{titles.rstrip()}{RESET}")
    return "\n".join(lines)


def legend_lines(items: list[tuple[str, str]], width: int) -> list[str]:
    """The key legend, wrapped so no line is wider than WIDTH cells."""
    lines: list[list[tuple[str, str]]] = [[]]
    used = 0
    for label, colour in items:
        need = len(label) + (1 if lines[-1] else 0)
        if lines[-1] and used + need > width:
            lines.append([])
            used, need = 0, len(label)
        lines[-1].append((label, colour))
        used += need
    return [
        "  " + " ".join(ansi_style(label, fg=colour) for label, colour in line)
        for line in lines
    ]


def fzf_border(env: Mapping[str, str] = os.environ) -> str:
    """Avoid a second border inside tmux's already-bordered popup."""
    return "none" if env.get("TMUX") and not env.get("TMUX_PANE") else "rounded"


def sanitize_session_part(part: str) -> str:
    # tmux normalizes dots in session names to underscores, and dotted target
    # names are parsed as window/pane separators. Generate the normalized form
    # ourselves so create and attach paths agree.
    cleaned = re.sub(r"[^A-Za-z0-9_-]+", "-", part.replace(".", "_"))
    return re.sub(r"-+", "-", cleaned).strip("-")


def session_name_for_path(path: str) -> str:
    resolved = Path(path).expanduser().resolve()
    home = Path.home().resolve()
    try:
        parts = resolved.relative_to(home).parts
    except ValueError:
        parts = tuple(
            part for part in resolved.parts if part not in {resolved.anchor, "/"}
        )
    sanitized = [sanitize_session_part(part) for part in parts]
    sanitized = [part for part in sanitized if part]
    return "/".join(sanitized) or "session"


def display_name_for_path(path: str) -> str:
    return Path(path).expanduser().name or session_name_for_path(path)


def zoxide_paths() -> list[str]:
    if not shutil.which("zoxide"):
        return []
    result = run(["zoxide", "query", "--list"], check=False)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.split("\n") if line.strip()]


def glob_escape(name: str) -> str:
    """Make NAME match literally as a find -name pattern."""
    return re.sub(r"([*?\[\\])", r"\\\1", name)


def find_paths(config: Config) -> list[str]:
    home = str(Path.home())
    if shutil.which("fd"):
        cmd = ["fd", "-0", "-H", "-d", str(config.find_max_depth), "-t", "d"]
        for name in sorted(config.blacklist):
            cmd.extend(["-E", name])
        cmd.extend([".", home])
    else:
        cmd = ["find", home, "-mindepth", "1", "-maxdepth", str(config.find_max_depth)]
        # Prune blacklisted dirs so find never descends into them.
        names = sorted(config.blacklist)
        if names:
            cmd.append("(")
            for i, name in enumerate(names):
                cmd.extend(["-o"] * (i > 0) + ["-name", glob_escape(name)])
            cmd.extend([")", "-prune", "-o"])
        cmd.extend(["-type", "d", "-print0"])
    result = run(cmd, check=False)
    if result.returncode != 0:
        return []
    # NUL-separated: a path may hold \x1e or other bytes splitlines() breaks on.
    # A path with a newline cannot be one picker row, so it is not offered.
    return [
        p for p in result.stdout.split("\0") if p and "\n" not in p and "\r" not in p
    ]


def is_useful_path(path: str, *, mode: str, config: Config) -> bool:
    p = Path(path).expanduser()
    parts = p.parts
    basename = p.name

    if basename.startswith("."):
        return False
    # `parts` includes the basename, so a single pass against the union of
    # both deny-lists subsumes the per-basename and per-segment checks the
    # earlier version did separately.
    blocked = config.blacklist | config.noisy_basenames
    if any(part in blocked for part in parts):
        return False

    # Both sides must be resolved: on distros where /home symlinks to
    # /var/home, comparing a resolved path against a bare Path.home() makes
    # relative_to() raise for *every* path under $HOME, silently disabling
    # the dotdir and zoxide-depth filters below.
    home = Path.home().resolve()
    try:
        rel = p.resolve().relative_to(home)
        rel_parts = rel.parts
        if any(part.startswith(".") for part in rel_parts):
            return False
        if mode == "zoxide" and len(rel_parts) > 2:
            return False
    except OSError:
        # resolve() touches the filesystem: unreadable parent, deleted cwd
        # while resolving a relative path, ELOOP on platforms that still
        # report it. Treat an unresolvable path as "no extra filtering".
        pass
    except ValueError:
        # relative_to() when the resolved path is outside $HOME.
        pass

    return True


def require_str_list(value: object, key: str, path: Path) -> list[str]:
    if not isinstance(value, list):
        raise ConfigError(f"{path}: {key} must be an array of strings")
    items = [item for item in value if isinstance(item, str)]
    if len(items) != len(value):
        raise ConfigError(f"{path}: {key} must be an array of strings")
    return items


LEGACY_CONFIG_PATH = Path.home() / ".config" / "tmux" / "tms.toml"
DEFAULT_BLACKLIST = (".cache", ".config", ".local", "Library", "tmp")
DEFAULT_NOISY = ("node_modules", "target", "dist", "build", ".git")


def default_preview_command() -> str:
    if shutil.which("eza"):
        return "eza --all --git --icons --color=always {path}"
    return "ls -la {path}"


def config_path() -> Path | None:
    """The config to read: ours, the pre-rename one with a warning, or none."""
    if CONFIG_PATH.exists():
        return CONFIG_PATH
    if LEGACY_CONFIG_PATH.exists() and "TSESH_CONFIG" not in os.environ:
        print(
            f"tsesh: reading {LEGACY_CONFIG_PATH}; move it to {CONFIG_PATH}",
            file=sys.stderr,
        )
        return LEGACY_CONFIG_PATH
    return None


@cache
def load_config() -> Config:
    path = config_path()
    if path is None:
        return Config(
            sessions=(),
            blacklist=frozenset(DEFAULT_BLACKLIST),
            noisy_basenames=frozenset(DEFAULT_NOISY),
            find_max_depth=2,
            preview_command=default_preview_command(),
        )
    try:
        with path.open("rb") as handle:
            data = tomllib.load(handle)
    except OSError as exc:
        raise ConfigError(f"Failed to read config: {path}: {exc}") from exc
    except tomllib.TOMLDecodeError as exc:
        raise ConfigError(f"Invalid TOML in {path}: {exc}") from exc

    blacklist = require_str_list(
        data.get("blacklist", list(DEFAULT_BLACKLIST)), "blacklist", path
    )
    noisy_basenames = require_str_list(
        data.get("noisy_basenames", list(DEFAULT_NOISY)), "noisy_basenames", path
    )
    find_max_depth = data.get("find_max_depth", 2)
    preview_command = data.get("preview_command") or default_preview_command()
    sessions = data.get("sessions", [])
    live_session_threshold = data.get("live_session_threshold", 0)
    fzf_exact = data.get("fzf_exact", True)
    if not isinstance(find_max_depth, int) or find_max_depth < 0:
        raise ConfigError(f"{path}: find_max_depth must be a non-negative integer")
    if not isinstance(preview_command, str) or not preview_command:
        raise ConfigError(f"{path}: preview_command must be a non-empty string")
    if not isinstance(sessions, list):
        raise ConfigError(f"{path}: sessions must be an array")
    if (
        not isinstance(live_session_threshold, int)
        or isinstance(live_session_threshold, bool)
        or live_session_threshold < 0
    ):
        raise ConfigError(
            f"{path}: live_session_threshold must be a non-negative integer"
        )
    if not isinstance(fzf_exact, bool):
        raise ConfigError(f"{path}: fzf_exact must be a boolean")

    out: list[SessionConfig] = []
    for session in sessions:
        if not isinstance(session, dict):
            raise ConfigError(f"{path}: each session must be an object")
        name = session.get("name")
        session_path = session.get("path")
        if not isinstance(name, str) or not name:
            raise ConfigError(f"{path}: session.name must be a non-empty string")
        if not isinstance(session_path, str) or not session_path:
            raise ConfigError(f"{path}: session.path must be a non-empty string")
        startup = session.get("startup", "")
        if not isinstance(startup, str):
            raise ConfigError(f"{path}: session.startup must be a string")
        split = session.get("split", DEFAULT_SPLIT)
        if split not in {DEFAULT_SPLIT, "vertical", "horizontal"}:
            raise ConfigError(
                f"{path}: session.split must be '', 'vertical', or 'horizontal'"
            )
        out.append(
            SessionConfig(name=name, path=session_path, startup=startup, split=split)
        )

    return Config(
        sessions=tuple(out),
        blacklist=frozenset(blacklist),
        noisy_basenames=frozenset(noisy_basenames),
        find_max_depth=find_max_depth,
        preview_command=preview_command,
        live_session_threshold=live_session_threshold,
        fzf_exact=fzf_exact,
    )


def effective_initial_mode(mode: str, live: Mapping[str, object]) -> str:
    """Resolve the picker's *opening* mode, applying the live-session threshold.

    Only `all` (the default landing view) is eligible for auto-switching; if
    the caller explicitly asked for a specific mode we honor it. The threshold
    is read from config and 0 disables the behavior. fzf's reload binds use
    the original mode strings, so `^a` still pulls up the merged view.
    """
    if mode != "all":
        return mode
    threshold = load_config().live_session_threshold
    if threshold <= 0:
        return mode
    if len(live) >= threshold:
        return "sessions"
    return mode


def build_path_entries(
    *,
    kind: str,
    paths: list[str],
    configured_paths: set[str],
    mode: str,
    config: Config,
) -> list[Entry]:
    configured_real_paths = {os.path.realpath(path) for path in configured_paths}
    seen_paths: set[str] = set()
    entries: list[Entry] = []
    for path in paths:
        full = expand(path)
        real = os.path.realpath(full)
        if (
            real in configured_real_paths
            or real in seen_paths
            or not is_useful_path(full, mode=mode, config=config)
        ):
            continue
        seen_paths.add(real)
        entries.append(
            Entry(
                kind=kind,
                name=display_name_for_path(full),
                session_name=session_name_for_path(full),
                path=full,
            )
        )
    return entries


def murmur_command() -> str | None:
    return shutil.which(os.environ.get("TSESH_MURMUR", "murmur"))


def _reject_constant(name: str) -> object:
    raise ValueError(f"non-finite number in murmur's JSON: {name}")


RENDER_STATES = {"crashed", "error", "blocked", "done", "working", "waiting", "idle"}


def _is_str(value: object) -> bool:
    # A NUL cannot be a tmux argument or a path: it would raise at the call.
    return isinstance(value, str) and "\x00" not in value


def _is_str_or_none(value: object) -> bool:
    return value is None or _is_str(value)


def _is_bool(value: object) -> bool:
    return isinstance(value, bool)


def _is_pane_id(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"%[0-9]+", value) is not None


def is_object(value: object) -> TypeGuard[dict[str, object]]:
    """A JSON object: a dict whose keys are all strings."""
    return isinstance(value, dict) and all(isinstance(k, str) for k in value)


def _is_server(value: object) -> bool:
    if not is_object(value):
        return False
    kind = value.get("kind")
    if kind == "default":
        return True
    return (
        isinstance(kind, str)
        and kind in {"label", "path"}
        and _is_str(value.get("value"))
        and bool(value["value"])
    )


def _is_time(value: object) -> bool:
    if value is None:
        return True
    if isinstance(value, bool):
        return False
    if isinstance(value, int):
        return -(2**63) <= value < 2**63
    return isinstance(value, float) and math.isfinite(value)


def _is_state(value: object) -> bool:
    return isinstance(value, str) and value in RENDER_STATES


# Every pane field tsesh consumes, with its type check. One bad pane rejects
# the whole snapshot: half-trusting a malformed document is worse than the
# plain @murmur_session_state view. Pane ids must be %N: they reach tmux as
# targets, where "notes" or "%1; ..." would mean something else.
PANE_FIELDS = {
    "pane": _is_pane_id,
    "local": _is_bool,
    "host": _is_str,
    "server": _is_server,
    "session_name": _is_str_or_none,
    "window_name": _is_str_or_none,
    "render_state": _is_state,
    "label": _is_str,
    "visible": _is_bool,
    "jump_target": lambda v: _is_str(v) and bool(v),
    "updated_at": _is_time,
    "attached_pane": lambda v: v is None or _is_pane_id(v),
    "workstream": _is_str_or_none,
}


def valid_pane(pane: object) -> bool:
    if not is_object(pane):
        return False
    return all(k in pane and check(pane[k]) for k, check in PANE_FIELDS.items())


def valid_peer(peer: object) -> bool:
    """A peer as the session notice reads it; fetched_at and target are
    optional (target is the ssh target, which can differ from the name)."""
    return (
        is_object(peer)
        and _is_str(peer.get("name"))
        and _is_bool(peer.get("needs_session"))
        and _is_time(peer.get("fetched_at"))
        and _is_str_or_none(peer.get("target"))
    )


def utf8_clean(data: object) -> bool:
    """Every string in a parsed document, keys included, encodes as UTF-8.

    JSON may carry a lone surrogate (``"\\ud800"``) that no output stream
    can write; one such string rejects the snapshot rather than a later print.
    """
    try:
        json.dumps(data, ensure_ascii=False).encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


@dataclass(frozen=True)
class Snapshot:
    panes: list[dict]
    peers: list[dict]


# Why a murmur snapshot could not be read, as the agents view words it.
NO_MURMUR = "murmur not installed"
OLD_MURMUR = "murmur too old for the agent view"
SLOW_MURMUR = "murmur did not answer in time"


# Views that read murmur's snapshot.
MURMUR_MODES = frozenset({"all", "sessions", "agents"})

# A ``status --json --cached`` started early by prefetch_murmur: the process
# and the murmur it runs.
_PENDING_STATUS: tuple[subprocess.Popen[str], str] | None = None


def _start_status(exe: str) -> subprocess.Popen[str]:
    return subprocess.Popen(
        [exe, "status", "--json", "--cached"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )


def prefetch_murmur(mode: str) -> None:
    """Start murmur's snapshot read now, so node starts up while tsesh asks
    tmux; murmur_snapshot collects the answer. A no-op for a view without
    murmur, without murmur installed, or with a read already started."""
    global _PENDING_STATUS
    if mode not in MURMUR_MODES or _PENDING_STATUS is not None:
        return
    exe = murmur_command()
    if exe is None:
        return
    with contextlib.suppress(OSError):
        _PENDING_STATUS = (_start_status(exe), exe)


# murmur's ambient collect skips a peer attempted within its floor (30s, less
# up to half its 20s jitter), so a peer fetched more recently than this is not
# due and starting a collect for it is a wasted node process.
PEER_FRESH_MS = 20_000


def peers_due(peers: list[dict], now_ms: float | None = None) -> bool:
    """Whether a ``collect --floored`` could fetch any peer: one that is
    stale, never fetched, or fetched longer ago than PEER_FRESH_MS."""
    now_ms = time.time() * 1000 if now_ms is None else now_ms
    for peer in peers:
        fetched = peer.get("fetched_at")
        if peer.get("stale") is True or not isinstance(fetched, (int, float)):
            return True
        if now_ms - fetched >= PEER_FRESH_MS:
            return True
    return False


def _lower_priority() -> None:
    with contextlib.suppress(OSError):
        os.nice(10)


def murmur_snapshot() -> tuple[Snapshot | None, str]:
    """murmur's agent panes and peers, or None and the reason there are none.

    One cache-only read (``status --json --cached``: it never reaches a peer),
    under a short timeout; started by prefetch_murmur when a caller could.
    Capability is probed by the call itself: it must succeed and the panes
    must carry the derived fields tsesh consumes (``render_state``,
    ``jump_target``; murmur publishes ``jump_target`` from the release that
    added ``murmur jump``). Version numbers are never compared. On success,
    when some peer is due a fetch, a detached low-priority ``collect`` warms
    the cache for the next open.
    """
    global _PENDING_STATUS
    exe = murmur_command()
    pending, _PENDING_STATUS = _PENDING_STATUS, None
    if exe is None:
        return None, NO_MURMUR
    timeout = float(os.environ.get("TSESH_MURMUR_TIMEOUT", "1"))
    try:
        proc = pending[0] if pending and pending[1] == exe else _start_status(exe)
        try:
            stdout, _ = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.communicate()
            return None, SLOW_MURMUR
        data = (
            json.loads(stdout, parse_constant=_reject_constant)
            if proc.returncode == 0
            else None
        )
    except (OSError, ValueError):
        return None, OLD_MURMUR
    if not utf8_clean(data):
        return None, OLD_MURMUR
    panes = data.get("panes") if isinstance(data, dict) else None
    peers = data.get("peers", []) if isinstance(data, dict) else None
    if not isinstance(panes, list) or not all(valid_pane(p) for p in panes):
        return None, OLD_MURMUR
    if not isinstance(peers, list) or not all(valid_peer(p) for p in peers):
        return None, OLD_MURMUR
    if peers_due(peers):
        with contextlib.suppress(OSError):
            subprocess.Popen(
                [exe, "collect", "--quiet", "--floored"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                preexec_fn=_lower_priority,
            )
    return Snapshot(panes, peers), ""


def named_socket(name: str) -> str | None:
    """The physical socket a tmux -L NAME reaches now.

    Resolved like a -S path: a symlink in tmux's socket directory is an alias
    that can be retargeted after a proof is made (see pinned_server).
    """
    conventional = conventional_tmux_dir()
    return os.path.realpath(os.path.join(conventional, name)) if conventional else None


def conventional_tmux_dir() -> str | None:
    """Where tmux keeps its named sockets, as murmur derives it."""
    try:
        base = os.path.realpath(os.environ.get("TMUX_TMPDIR") or "/tmp")
        return os.path.join(base, f"tmux-{os.getuid()}")
    except OSError:
        return None


# The socket own_socket() resolved when this process started (see
# pin_own_server): None until then.
START_SOCKET: str | None = None


def pin_own_server() -> None:
    """Resolve tsesh's server once, before murmur is read, and talk to it.

    Every later proof compares against this one physical path, and every tmux
    call names it with -S, so an alias (-L name, $TMUX, a symlink) retargeted
    mid-run can neither pass a proof nor redirect a call. Without a server yet
    the socket does not exist; then calls keep the plain arguments, so tmux can
    create its socket directory when it starts one.
    """
    global START_SOCKET, PINNED_SOCKET
    START_SOCKET = resolve_own_socket()
    if START_SOCKET and os.path.exists(START_SOCKET):
        PINNED_SOCKET = START_SOCKET


def own_socket() -> str | None:
    """The socket tsesh's own tmux calls reach, or None when unknown."""
    return START_SOCKET or resolve_own_socket()


def resolve_own_socket() -> str | None:
    """The physical socket tsesh's tmux calls would reach now.

    Same precedence as the calls themselves: the TSESH_TMUX_SOCKET_* test
    overrides, then the socket in $TMUX (a bare tmux follows it), then the
    default socket.
    """
    if path := os.environ.get("TSESH_TMUX_SOCKET_PATH"):
        return os.path.realpath(path)
    if name := os.environ.get("TSESH_TMUX_SOCKET_NAME"):
        return named_socket(name)
    if ambient := os.environ.get("TMUX"):
        return os.path.realpath(ambient.split(",")[0])
    return named_socket("default")


def server_socket(server: object) -> str | None:
    """The socket a murmur ``server`` value names; None if it is not understood."""
    if not is_object(server):
        return None
    kind, value = server.get("kind"), server.get("value")
    if kind == "default":
        return named_socket("default")
    if kind == "label" and isinstance(value, str) and value:
        return named_socket(value)
    if kind == "path" and isinstance(value, str) and value:
        return os.path.realpath(value)
    return None


def is_own_server(server: object) -> bool:
    """True only when SERVER provably is the server tsesh talks to."""
    own, other = own_socket(), server_socket(server)
    return own is not None and own == other


def clean_field(value: object) -> str:
    """A murmur string made safe for one tab-separated row field."""
    return re.sub(r"[\t\r\n]+", " ", str(value or ""))


def age_text(updated_ms: object, now_ms: float | None = None) -> str:
    if not isinstance(updated_ms, (int, float)) or isinstance(updated_ms, bool):
        return ""
    now = time.time() * 1000 if now_ms is None else now_ms
    seconds = max(0, int((now - updated_ms) / 1000))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{seconds // size}{unit}"
    return f"{seconds}s"


ATTENTION_ROW_STATES = {"crashed", "error", "blocked", "done"}


def murmur_saw_own_server() -> bool:
    """Whether murmur's ambient tmux is the server tsesh queries.

    murmur computes ``attached_pane`` with a bare tmux, which follows $TMUX (or
    the default socket); the TSESH_TMUX_SOCKET_* overrides apply to tsesh only.
    A pane id seen behind an override is not evidence of the pane murmur meant.
    """
    if ambient := os.environ.get("TMUX"):
        murmur_socket = os.path.realpath(ambient.split(",")[0])
    else:
        murmur_socket = named_socket("default") or ""
    return bool(murmur_socket) and own_socket() == murmur_socket


def attached_session(pane_id: str) -> str | None:
    """The session of a local pane on tsesh's own server, or None.

    murmur reports a remote agent's ``attached_pane``: a pane here that holds
    the ssh session to it. murmur read it with the same ambient tmux tsesh
    uses, so it counts only if this server really has that pane.
    """
    result = tmux_bytes("display-message", "-p", "-t", pane_id, "#{session_name}")
    if result.returncode != 0:
        return None
    return os.fsdecode(result.stdout).removesuffix("\n") or None


def inside_own_server() -> bool:
    """Whether the invoking client is on the server tsesh's tmux calls reach.

    Only then may tsesh move the client itself; outside tmux, or from a client
    of another server, an agent is murmur's to reach.
    """
    ambient = os.environ.get("TMUX")
    return bool(ambient) and own_socket() == os.path.realpath(ambient.split(",")[0])


def current_location() -> tuple[str, str]:
    """(pane id, session name) of the invoking client: resolved before fzf
    starts (see resolve_invoker) and handed to reloads through the environment,
    or, on a cached open, found after fzf started and left in the picker's
    directory (see build_fresh).
    """
    if "TSESH_CURRENT_PANE" in os.environ:
        return (
            os.environ.get("TSESH_CURRENT_PANE", ""),
            os.environ.get("TSESH_CURRENT_SESSION", ""),
        )
    if directory := picker_dir():
        with contextlib.suppress(OSError):
            pane, _, session = (directory / "invoker").read_text().partition("\t")
            return pane, session
    return "", ""


def pane_state(pane: dict) -> AgentState:
    return AgentState[str(pane["render_state"])]


def agent_entry(pane: dict, *, detail: str = "", text: str = "") -> Entry:
    """An agent row: the payload every view shares, with the all view's
    DETAIL or the agents view's pre-rendered TEXT."""
    is_here = bool(pane.get("local")) and is_own_server(pane.get("server"))
    pane_id = clean_field(pane.get("pane"))
    current = is_here and pane_id == current_location()[0]
    return Entry(
        kind="agent",
        name=clean_field(pane.get("label")),
        session_name=clean_field(pane.get("session_name")),
        worst_state=pane_state(pane),
        is_running=True,
        host=clean_field(pane.get("host")),
        pane=pane_id,
        jump_target=clean_field(pane.get("jump_target")),
        here="1" if is_here else "",
        socket=(own_socket() or "") if is_here else "",
        marker="current" if current else "",
        detail=detail,
        text=text,
    )


def agent_entries(
    panes: list[dict], live: Mapping[str, object], *, crew: bool = False
) -> tuple[list[Entry], dict[str, dict[AgentState, int]]]:
    """Attention rows for the all view, and per-session state counts.

    panes[] already arrives most-urgent first; it is not re-sorted. Only panes
    on the tmux server tsesh talks to count toward a live session's row.
    """
    counts: dict[str, dict[AgentState, int]] = {}
    rows: list[Entry] = []
    attached_cache: dict[str, str | None] = {}
    for pane in panes:
        state = pane_state(pane)
        is_here = bool(pane.get("local")) and is_own_server(pane.get("server"))
        session = clean_field(pane.get("session_name"))
        counted = session if is_here else None
        if (
            not pane.get("local")
            and pane.get("attached_pane")
            and murmur_saw_own_server()
        ):
            # A remote agent counts under the local session holding its ssh pane.
            attached = str(pane["attached_pane"])
            if attached not in attached_cache:
                attached_cache[attached] = attached_session(attached)
            counted = attached_cache[attached]
        if counted and counted in live:
            per = counts.setdefault(counted, {})
            per[state] = per.get(state, 0) + 1
        if str(pane.get("render_state")) in ATTENTION_ROW_STATES and (
            crew or pane.get("visible")
        ):
            where = f"{session}:{clean_field(pane.get('window_name'))}".strip(":")
            parts = [clean_field(pane.get("host")), where]
            parts.append(age_text(pane.get("updated_at")))
            rows.append(
                agent_entry(pane, detail=" \u00b7 ".join(p for p in parts if p))
            )
    return rows, counts


def agent_stream(pane: dict) -> str:
    """Which piece of work: mu's workstream, else the tmux session; blank when
    it would repeat the label."""
    stream = clean_field(pane.get("workstream") or pane.get("session_name"))
    return "" if stream == clean_field(pane.get("label")) else stream


def agent_view_entries(
    panes: list[dict], *, crew: bool
) -> tuple[list[Entry], AgentColumns, dict[AgentState, int]]:
    """Rows of the agents view: every agent murmur marks visible (all of them
    with CREW), in murmur's order, with the columns they need and the count of
    shown agents per state."""
    shown = [p for p in panes if crew or p.get("visible")]
    columns = AgentColumns(
        stream=any(agent_stream(p) for p in shown),
        host=any(not p.get("local") for p in shown),
    )
    stream_on, host_on = LAYOUT.agent_columns(columns.stream, columns.host)
    counts: dict[AgentState, int] = {}
    rows: list[Entry] = []
    for pane in shown:
        state = pane_state(pane)
        counts[state] = counts.get(state, 0) + 1
        label = clean_field(pane.get("label"))
        label = fit(row_escape(label), LAYOUT.name_width, keep="middle")
        cells = [f"{STATE_GLYPH[state]} {label}"]
        if stream_on:
            cells.append(fit(row_escape(agent_stream(pane)), STREAM_WIDTH))
        if host_on:
            host = clean_field(pane.get("host"))
            where = "here" if pane.get("local") else f"\u2192 {host}"
            cells.append(fit(row_escape(where), HOST_WIDTH))
        cells.append(age_text(pane.get("updated_at")))
        rows.append(agent_entry(pane, text=" ".join(cells).rstrip()))
    return rows, columns, counts


# murmur's ControlPath: warming a socket here is what lets it collect again.
MURMUR_CONTROL_PATH = "~/.ssh/control/%r@%h:%p"


def session_notice(peers: list[dict]) -> str:
    """murmur's notice for peers that need an interactive session, or "".

    As murmur words it (paint.ts sessionNotice): up to three gated peers,
    oldest first, when the oldest was last reached, and the command that warms
    an ssh socket for it, built from its ssh target (a peer name may differ).
    """
    gated = sorted(
        (p for p in peers if p["needs_session"]),
        key=lambda p: p.get("fetched_at") or 0,
    )
    if not gated:
        return ""
    oldest = gated[0]
    names = ", ".join(clean_field(p["name"]) for p in gated[:3])
    fetched = oldest.get("fetched_at")
    if fetched is None:
        seen = "never"
    elif time.time() * 1000 - fetched < 60_000:
        seen = "just now"
    else:
        seen = age_text(fetched)
    target = clean_field(oldest.get("target") or oldest["name"])
    command = f"ssh -MNf -S {MURMUR_CONTROL_PATH} {target}"
    peach = CATPPUCCIN["peach"]
    return (
        ansi_style(
            f"{STATE_GLYPH[AgentState.blocked]} {names}: re-auth needed",
            fg=peach,
            bold=True,
        )
        + ansi_style(f" (last seen {seen}) \u2014 ", fg=peach)
        + ansi_style(command, fg=peach, bold=True)
    )


@dataclass(frozen=True)
class View:
    entries: list[Entry]
    header: str
    prompt: str


def agents_view(crew: bool) -> View:
    snapshot, problem = murmur_snapshot()
    if snapshot is None:
        status = ansi_style(problem, fg=CATPPUCCIN["peach"])
        return View(
            [], header_text("agents", status=status), prompt_text("agents", crew)
        )
    rows, columns, counts = agent_view_entries(snapshot.panes, crew=crew)
    status = ""
    if not rows:
        hidden = sum(1 for p in snapshot.panes if not p.get("visible"))
        status = f"No human agents (+{hidden} crew: ctrl-g)" if hidden else "No agents"
        status = ansi_style(status, fg=CATPPUCCIN["subtext0"])
    header = header_text(
        "agents",
        notice=session_notice(snapshot.peers),
        status=status,
        columns=columns,
    )
    return View(rows, header, prompt_text("agents", crew, counts))


def build_entries(
    mode: str, live: Mapping[str, AgentState | None] | None = None
) -> list[Entry]:
    return build_view(mode, live).entries


def build_view(
    mode: str,
    live: Mapping[str, AgentState | None] | None = None,
    *,
    crew: bool = False,
) -> View:
    prefetch_murmur(mode)
    if mode == "agents":
        return agents_view(crew)
    config = load_config()
    configured_sessions = config.sessions
    configured_paths = {expand(session.path) for session in configured_sessions}
    # One list-sessions call; murmur keeps @murmur_session_state current.
    if live is None:
        live = backend().live_sessions()
    live_names = set(live)
    attached = getattr(live, "attached", frozenset())
    current_session = current_location()[1]
    ids = getattr(live, "ids", {})
    states = dict(live)
    entries: list[Entry] = []
    session_counts: dict[str, dict[AgentState, int]] = {}
    notice = ""
    snapshot = murmur_snapshot()[0] if mode in {"all", "sessions"} else None
    if snapshot is not None:
        notice = session_notice(snapshot.peers)
        agent_rows, session_counts = agent_entries(snapshot.panes, live, crew=crew)
        for name, per in session_counts.items():
            active = [st for st in per if st is not AgentState.idle]
            if not active:
                continue  # idle agents never colour a row
            strongest = max(active)
            current = states.get(name)
            if current is None or current < strongest:
                states[name] = strongest
        if mode == "all":
            entries.extend(agent_rows)

    def counts_for(name: str) -> tuple[tuple[AgentState, int], ...]:
        per = session_counts.get(name, {})
        return tuple(sorted(per.items(), key=lambda item: -item[0]))

    def marker_for(name: str) -> str:
        if name in live_names and name == current_session:
            return "current"
        return "attached" if name in attached else ""

    def where(name: str) -> dict[str, str]:
        """A live row's path: the active pane's cwd, and "+N" for the other
        directories its windows sit in."""
        if name not in live_names or not isinstance(live, LiveSessions):
            return {}
        cwd, others = live.location(name)
        found = {"counts": live.counts(name)}
        if cwd:
            found["detail"] = tildify(cwd)
            found["extra"] = f"+{others}" if others else ""
        return found

    # A directory with a live session is offered by that session's row only.
    taken = configured_paths | (
        live.dirs() if isinstance(live, LiveSessions) else set()
    )

    if mode in {"all", "sessions"}:
        entries.extend(
            Entry(
                kind="default",
                name=session.name,
                session_name=session.name,
                path=expand(session.path),
                startup=session.startup,
                split=session.split,
                worst_state=states.get(session.name),
                is_running=session.name in live_names,
                agent_counts=counts_for(session.name),
                marker=marker_for(session.name),
                session_id=ids.get(session.name, ""),
                **where(session.name),
            )
            for session in configured_sessions
        )

    if mode in {"all", "sessions"}:
        configured_names = {session.name for session in configured_sessions}
        # Most recently active first; pinned sessions keep the config order.
        activity = getattr(live, "activity", {})
        for session_name in sorted(
            live_names, key=lambda name: (-activity.get(name, 0), name)
        ):
            if session_name in configured_names:
                continue
            entries.append(
                Entry(
                    kind="tmux",
                    name=session_name,
                    session_name=session_name,
                    worst_state=states.get(session_name),
                    is_running=True,
                    agent_counts=counts_for(session_name),
                    marker=marker_for(session_name),
                    session_id=ids.get(session_name, ""),
                    **where(session_name),
                )
            )

    if mode == "all":
        entries.extend(
            build_path_entries(
                kind="zoxide",
                paths=zoxide_paths(),
                configured_paths=taken,
                mode="zoxide",
                config=config,
            )
        )

    if mode == "find":
        entries.extend(
            build_path_entries(
                kind="find",
                paths=find_paths(config),
                configured_paths=taken,
                mode="find",
                config=config,
            )
        )

    return View(entries, header_text(mode, notice=notice), prompt_text(mode, crew))


def tmux_session_preview(name: str) -> bool:
    """Print a live session's windows and its active pane; False if the
    session is not there.

    One tmux call: the window list, a marker line, then the capture. The
    window list fails for a missing session and stops the chain before the
    marker.
    """
    marker = f"tsesh-{os.urandom(8).hex()}"
    result = tmux_cmd(
        "list-windows",
        "-t",
        exact_session_target(name),
        "-F",
        # The pane fields are the window's active pane. The path last: it
        # may hold a tab (a window name is assumed not to).
        "#{session_attached}\t#{window_index}\t#{window_active}\t#{window_panes}"
        "\t#{@murmur_window_state}\t#{pane_index}\t#{pane_current_command}"
        "\t#{window_name}\t#{pane_current_path}",
        ";",
        "display-message",
        "-p",
        marker,
        ";",
        "capture-pane",
        "-p",
        "-J",
        "-t",
        active_pane_target(name),
        "-S",
        "-200",
        check=False,
    )
    windows, found, capture = result.stdout.partition(f"{marker}\n")
    if not found:
        return False

    attached = ""
    attention_total = 0
    active_pane = ""
    window_lines: list[str] = []
    for line in windows.splitlines():
        parts = line.split("\t", 8)
        if len(parts) != 9:
            continue
        attached, index, active, pane_count, raw_state = parts[:5]
        pane_index, command, window_name, window_path = parts[5:]
        state = AgentState.parse(raw_state)
        if state in ATTENTION_STATES:
            attention_total += 1
        if active == "1" and not active_pane:
            active_pane = f"{pane_index}  {command}"
        glyph = STATE_GLYPH[state] if state else " "
        window_lines.append(
            f"{'*' if active == '1' else ' '} {index} {glyph} {window_name}"
            f"  {pane_count}p  {tildify(window_path)}"
        )

    meta: list[str] = []
    if attached:
        meta.append(f"attached {attached}")
    if attention_total:
        meta.append(f"attention {attention_total}")
    suffix = f" ({', '.join(meta)})" if meta else ""
    print(f"{name}{suffix}")
    # Every window: active marker, index, state, name, panes, cwd.
    for line in window_lines:
        print(line)
    if active_pane:
        print(f"pane: {active_pane}")
    print()

    if result.returncode != 0:
        print("(unable to capture active pane)")
        return True
    print(capture.rstrip())
    return True


def preview(
    path: str,
    session_name: str = "",
    kind: str = "",
    split: str = "",
    host: str = "",
    pane: str = "",
    here: str = "",
    socket: str = "",
) -> int:
    if kind == "agent":
        if proven_here(here, socket) and pane:
            with pinned_server(socket):
                capture = tmux_cmd(
                    "capture-pane", "-p", "-J", "-t", pane, "-S", "-200", check=False
                )
            if capture.returncode == 0:
                print(capture.stdout.rstrip())
                return 0
        print(f"host: {host or '(unknown)'}\nsession: {session_name or '(unknown)'}")
        return 0
    live = kind in {"tmux", "default"} and session_name
    if live and tmux_session_preview(session_name):
        return 0

    target = expand(path) if path else ""
    if not target:
        if split and kind == "default":
            print(f"session: {session_name or '(unknown)'}\nsplit: {split}", end="")
        else:
            print(f"session: {session_name or '(unknown)'}", end="")
        return 0
    if split:
        print(f"split: {split}\n")
    command = load_config().preview_command
    if command == default_preview_command():
        # No shell for the built-in command: a login shell costs more than
        # the listing.
        argv = [target if word == "{path}" else word for word in command.split()]
        os.execvp(argv[0], argv)
    else:
        os.execvp("sh", ["sh", "-lc", command.format(path=sh_quote(target))])
    return 0


def reload_cmd(mode: str, crew: bool = False) -> str:
    crew_flag = " --crew" if crew else ""
    return f"{sh_quote(sys.argv[0])} list --mode {mode}{crew_flag}"


def kill_bind() -> str:
    """ctrl-x: kill the highlighted session row, then redraw the current view.

    Only live session rows carry an id; the `=` form keeps an empty one from
    eating the next flag. fzf exports the live prompt as FZF_PROMPT, which
    names the view.
    """
    me = sh_quote(sys.argv[0])
    client = f" --client {sh_quote(INVOKING_CLIENT)}" if INVOKING_CLIENT else ""
    kind = FZF_ROW_FIELDS.index("kind") + 1
    field = FZF_ROW_FIELDS.index("session_id") + 1
    return (
        f"ctrl-x:execute-silent({me} kill --kind={{{kind}}}"
        f" --session-id={{{field}}}{client})"
        f'+reload({me} list --prompt "$FZF_PROMPT")'
    )


# Set for fzf's children: where `list` leaves the header and prompt of the view
# it printed, for the `load` binding to pick up.
PICKER_DIR_ENV = "TSESH_PICKER_DIR"


def write_view_files(directory: str, view: View) -> None:
    for name, text in (("header", view.header), ("prompt", view.prompt)):
        write_atomic(Path(directory, name), text)


def write_atomic(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.{os.getpid()}")
    tmp.write_text(text)
    tmp.replace(path)


# The optimistic open. pick-and-connect starts fzf on the rows the last open of
# the same view left in a cache, builds the fresh view itself meanwhile (Python
# is already running), and hands it to fzf over fzf's --listen socket. Files in
# the picker's directory carry the handover:
#   rows      the fresh rows, for the posted `reload(cat rows)`
#   switched  a view key or kill ran first: leave fzf's own reload alone
#   invoker   "pane<TAB>session" of the invoking client, for later reloads,
#             when pick-and-connect found it only after fzf started
# fzf keeps the cursor's index, not its row, across a reload (and --track
# would drop keys while one runs), so an Enter on a cached row is looked up
# again in the fresh build before tsesh acts on it.


@dataclass(frozen=True)
class CachedView:
    mode: str  # the view the rows show (all may have opened as sessions)
    header: str
    prompt: str
    rows: list[str]


def view_cache_path(mode: str) -> Path:
    """The cache for opening MODE: one per tsesh version, tmux server and list
    width, since rows are laid out for one width and proven for one server."""
    key = json.dumps([VERSION, mode, own_socket() or "", LAYOUT.columns])
    digest = hashlib.sha256(key.encode()).hexdigest()[:16]
    return STATE_DIR / "views" / f"{mode}-{digest}.json"


def read_view_cache(path: Path) -> CachedView | None:
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    if not is_object(data) or data.get("version") != VERSION:
        return None
    mode, header, prompt, rows = (
        data.get(k) for k in ("mode", "header", "prompt", "rows")
    )
    if mode not in MODES or not (_is_str(header) and _is_str(prompt)):
        return None
    fields = len(FZF_ROW_FIELDS)
    if not isinstance(rows, list) or not all(
        _is_str(r) and "\n" not in r and r.count("\t") == fields - 1 for r in rows
    ):
        return None
    return CachedView(str(mode), str(header), str(prompt), [str(r) for r in rows])


def write_view_cache(path: Path, mode: str, view: View, rows: list[str]) -> None:
    doc = {
        "version": VERSION,
        "mode": mode,
        "header": view.header,
        "prompt": view.prompt,
        "rows": rows,
    }
    with contextlib.suppress(OSError):
        path.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(path, json.dumps(doc))


def picker_dir() -> Path | None:
    directory = os.environ.get(PICKER_DIR_ENV)
    return Path(directory) if directory else None


def mark_switched() -> None:
    """The picker's own reload now owns the list (see the comment above)."""
    if directory := picker_dir():
        with contextlib.suppress(OSError):
            (directory / "switched").touch()


@dataclass(frozen=True)
class Fresh:
    """The rows of the fresh view a cached open built while fzf showed the
    cache."""

    rows: list[str]

    def choice(self, row: str) -> EntryPayload | None:
        """ROW as it is now: itself when fresh, else the fresh row with the
        same identity, or None when that row is gone."""
        if row in self.rows:
            return EntryPayload.from_fzf_row(row)
        wanted = row_identity(EntryPayload.from_fzf_row(row))
        for fresh_row in self.rows:
            payload = EntryPayload.from_fzf_row(fresh_row)
            if row_identity(payload) == wanted:
                return payload
        return None


def row_identity(payload: EntryPayload) -> tuple[str, ...]:
    """What makes two picker rows the same row, whatever their state."""
    return (
        payload.kind,
        payload.session_name,
        payload.path or "",
        payload.host,
        payload.pane,
    )


def build_fresh(
    mode: str, directory: Path, cache_path: Path | None, client: str | None
) -> Fresh:
    """The opening view of MODE, built while fzf shows the cache: in the
    picker's directory for fzf, and in the cache for the next open. CLIENT:
    the invoking client whose pane is still to be found."""
    prefetch_murmur(mode)
    if client is not None:
        _, pane, session = resolve_invoker(client)
        os.environ["TSESH_CURRENT_PANE"] = pane
        os.environ["TSESH_CURRENT_SESSION"] = session
        with contextlib.suppress(OSError):
            write_atomic(directory / "invoker", f"{pane}\t{session}")
    live: Mapping[str, AgentState | None] | None = None
    if mode != "agents":
        live = backend().live_sessions()
        mode = effective_initial_mode(mode, live)
    view = build_view(mode, live)
    rows = [entry.to_fzf_row() for entry in view.entries]
    write_view_files(str(directory), view)
    write_atomic(directory / "rows", "".join(f"{row}\n" for row in rows))
    if cache_path is not None:
        write_view_cache(cache_path, mode, view, rows)
    return Fresh(rows)


def fzf_post(sock: Path, action: str, proc: subprocess.Popen[str]) -> None:
    """Send ACTION to the fzf listening on SOCK; quietly give up when fzf has
    exited or never opens its socket."""
    body = action.encode()
    request = (
        b"POST / HTTP/1.1\r\nHost: localhost\r\n"
        + f"Content-Length: {len(body)}\r\n\r\n".encode()
        + body
    )
    deadline = time.monotonic() + 2
    while proc.poll() is None and time.monotonic() < deadline:
        try:
            with socket.socket(socket.AF_UNIX) as conn:
                conn.settimeout(1)
                conn.connect(str(sock))
                conn.sendall(request)
                conn.recv(64)
            return
        except OSError:
            time.sleep(0.01)


def print_entries(mode: str, crew: bool = False) -> int:
    view = build_view(mode, crew=crew)
    if directory := picker_dir():
        with contextlib.suppress(OSError):
            write_view_files(str(directory), view)
    for entry in view.entries:
        print(entry.to_fzf_row())
    return 0


def fzf_action(target: str) -> int:
    """fzf `transform` for a view key: switch to TARGET, keeping the crew
    toggle; the agents key pressed in the agents view flips it instead.

    The state comes from $FZF_PROMPT (see prompt_text), never from a value
    fixed when the bindings were built.
    """
    mark_switched()
    mode, crew = prompt_state(os.environ.get("FZF_PROMPT", ""))
    if target == "agents" and mode == "agents":
        crew = not crew
    # "current": the popup was resized. Lay the same view out again, and move
    # the preview for the new width.
    resized = target == "current"
    if resized:
        target = mode
    actions = [
        f"change-prompt({prompt_text(target, crew)})",
        f"reload({reload_cmd(target, crew)})",
    ]
    if resized:
        actions.insert(0, f"change-preview-window({LAYOUT.preview_window})")
    print("+".join(actions))
    return 0


def fzf_enter() -> int:
    """fzf `transform` for Enter: accept only when a row matches."""
    if os.environ.get("FZF_MATCH_COUNT", "1") != "0":
        print("accept")
    return 0


VIEW_KEYS = {
    "ctrl-a": "all",
    "ctrl-s": "sessions",
    "ctrl-g": "agents",
    "ctrl-f": "find",
}


def _fzf_command(
    mode: str,
    query: str = "",
    *,
    header: str | None = None,
    prompt: str | None = None,
    state_dir: str = "",
    listen: str = "",
) -> list[str]:
    self_cmd = sh_quote(sys.argv[0])
    cmd = [
        "fzf",
        "--layout=reverse",
        "--border",
        fzf_border(),
        "--ansi",
        # Match only the visible display column (field 1), not the payload
        # fields tacked on for the consumer (kind/session/path/startup/split).
        # Otherwise typing `dotfiles` would also match every row whose path
        # happens to contain the word.
        "--nth",
        "1",
        # `begin` ranks earlier match positions higher: query `notes` puts
        # `notes` (pos 0) above `my-notes` (pos 3). `index` is the empty-query
        # fallback: with no scoring signal it preserves the input grouping
        # (pinned -> live -> zoxide -> find) we hand to fzf.
        "--tiebreak",
        "begin,index",
        "--color",
        f"bg:{CATPPUCCIN['base']},bg+:{CATPPUCCIN['surface0']},fg:{CATPPUCCIN['text']},fg+:{CATPPUCCIN['text']},hl:{CATPPUCCIN['sky']},hl+:{CATPPUCCIN['sky']},border:{CATPPUCCIN['overlay0']},gutter:{CATPPUCCIN['base']},header:{CATPPUCCIN['subtext0']},info:{CATPPUCCIN['overlay0']},prompt:{CATPPUCCIN['lavender']},pointer:{CATPPUCCIN['peach']},marker:{CATPPUCCIN['peach']},spinner:{CATPPUCCIN['sky']},label:{CATPPUCCIN['subtext0']},query:{CATPPUCCIN['text']},preview-bg:{CATPPUCCIN['base']},preview-border:{CATPPUCCIN['overlay0']}",
        "--delimiter",
        "\t",
        "--with-nth",
        "1",
        "--border-label",
        FZF_BORDER_LABEL,
        "--prompt",
        prompt_text(mode) if prompt is None else prompt,
        "--header",
        header_text(mode) if header is None else header,
        "--bind",
        "tab:down,btab:up",
    ]
    cmd += ["--bind", kill_bind()]
    # Enter with nothing to pick must not close the picker: an empty agents
    # view stays up, saying why, until esc. (accept-non-empty still exits on
    # an empty list.)
    cmd += ["--bind", f"enter:transform:{self_cmd} fzf-enter"]
    # transform: the binding decides per keypress from $FZF_PROMPT, so the
    # crew toggle holds across view switches (a fixed reload cannot know it).
    for key, view in VIEW_KEYS.items():
        cmd += ["--bind", f"{key}:transform:{self_cmd} fzf-action {view}"]
    if state_dir:
        # Each reload's `list` leaves its view's header and prompt here.
        d = Path(state_dir)
        cmd += [
            "--bind",
            f"load:transform-header(cat {sh_quote(str(d / 'header'))})"
            f"+transform-prompt(cat {sh_quote(str(d / 'prompt'))})",
        ]
    cmd += [
        "--preview-window",
        LAYOUT.preview_window,
        "--bind",
        "ctrl-/:toggle-preview",
        "--bind",
        f"resize:transform:{self_cmd} fzf-action current",
        "--preview",
        f"{self_cmd} preview --kind {{2}} --session-name {{3}} --path {{4}} --split {{6}} --host {{7}} --pane {{8}} --here {{10}} --socket {{11}}",
    ]
    if load_config().fzf_exact:
        # Substring (literal) matching only. Prefix a token with `'` to opt
        # back into fuzzy for that token.
        cmd.append("--exact")
    if query:
        cmd.extend(["--query", query])
    if listen:
        # A unix socket in the picker's private directory: only this user
        # can reach it.
        cmd.append(f"--listen={listen}")
    return cmd


def fzf_env() -> dict[str, str]:
    """Our environment without the user's fzf defaults: an inherited
    --exit-0 or --select-1 would close the picker or pick for them."""
    return {k: v for k, v in os.environ.items() if not k.startswith("FZF_DEFAULT_OPTS")}


def run_fzf(
    mode: str,
    query: str,
    *,
    capture: bool,
    cached: CachedView | None = None,
    cache_path: Path | None = None,
    client: str | None = None,
) -> tuple[subprocess.CompletedProcess[str], Fresh | None]:
    """Run the picker on MODE. CACHE_PATH: where to keep this open's rows.

    With CACHED, fzf starts on its rows while the fresh view is built here and
    then handed over (see the optimistic-open comment); CLIENT is the invoking
    client whose pane is still to be found. Returns fzf's result, and for a
    cached open the fresh view, to check the choice against.
    """
    if cached is None:
        # Only all -> sessions is an automatic switch below: both read murmur.
        prefetch_murmur(mode)
    with tempfile.TemporaryDirectory(prefix="tsesh-") as state_dir:
        directory = Path(state_dir)
        env = {**fzf_env(), PICKER_DIR_ENV: state_dir}
        if cached is not None:
            write_view_files(state_dir, View([], cached.header, cached.prompt))
            given = directory / "cached"
            given.write_text("".join(f"{row}\n" for row in cached.rows))
            sock = directory / "fzf.sock"
            cmd = _fzf_command(
                cached.mode,
                query=query,
                header=cached.header,
                prompt=cached.prompt,
                state_dir=state_dir,
                listen=str(sock),
            )
            with given.open() as rows_in:
                proc = subprocess.Popen(
                    cmd,
                    stdin=rows_in,
                    stdout=subprocess.PIPE if capture else None,
                    text=True,
                    env=env,
                )
            try:
                fresh = build_fresh(mode, directory, cache_path, client)
                if not (directory / "switched").exists():
                    rows_file = sh_quote(str(directory / "rows"))
                    fzf_post(sock, f"reload(cat {rows_file})", proc)
                out, _ = proc.communicate()
            except BaseException:
                proc.kill()
                proc.wait()
                raise
            done = subprocess.CompletedProcess(cmd, proc.returncode, out or "", "")
            return done, fresh
        if mode == "agents":
            # Works outside tmux and from other terminals: no server is
            # started and no session listed.
            live: Mapping[str, AgentState | None] = {}
        else:
            live = backend().snapshot()
            if live is None:
                backend().ensure_server()
                live = backend().live_sessions()
            mode = effective_initial_mode(mode, live)
        view = build_view(mode, live)
        rows = [entry.to_fzf_row() for entry in view.entries]
        if cache_path is not None:
            write_view_cache(cache_path, mode, view, rows)
        write_view_files(state_dir, view)
        cmd = _fzf_command(
            mode,
            query=query,
            header=view.header,
            prompt=view.prompt,
            state_dir=state_dir,
        )
        proc = subprocess.run(
            cmd,
            input="\n".join(rows),
            text=True,
            capture_output=capture,
            check=False,
            env=env,
        )
        return proc, None


# fzf's exit codes for "no selection": no match (1) and aborted (130).
FZF_NOTHING_CHOSEN = {1, 130}


def fzf(mode: str = "all", query: str = "") -> int:
    return run_fzf(mode, query, capture=False)[0].returncode


def pick_and_connect(mode: str = "all", query: str = "", client: str = "") -> int:
    """Run the fzf picker and connect to the selection in one step.

    fzf writes its UI to /dev/tty when stdout is captured, so the picker
    still renders interactively while we keep the selection in-process.
    """
    global INVOKING_CLIENT
    cache_path = view_cache_path(mode)
    # A cached open lists nothing before fzf, so it cannot start a server
    # first (ensure_server); only an agents view or a running server has one.
    usable = mode == "agents" or PINNED_SOCKET is not None
    cached = read_view_cache(cache_path) if usable else None
    if cached is None:
        prefetch_murmur(mode)  # node starts while tmux answers
    deferred: str | None = None
    if cached is not None and valid_client_name(client):
        # The client is all the bindings need now; its pane is found while
        # fzf already shows the cache, off the path to the first paint.
        INVOKING_CLIENT = deferred = client
    else:
        INVOKING_CLIENT, pane, session = resolve_invoker(client)
        # Read by every build of the picker's rows, reloads included.
        os.environ["TSESH_CURRENT_PANE"] = pane
        os.environ["TSESH_CURRENT_SESSION"] = session
    proc, fresh = run_fzf(
        mode,
        query,
        capture=True,
        cached=cached,
        cache_path=cache_path,
        client=deferred,
    )
    if proc.returncode in FZF_NOTHING_CHOSEN:
        # esc, ctrl-c, or enter with no match: a clean exit. run-shell would
        # otherwise print "returned 130" over the pane once the popup closes.
        return 0
    if proc.returncode != 0:
        return proc.returncode
    # Strip only the trailing newline fzf appends, not surrounding whitespace.
    # Picker rows can end in empty tab-separated fields (e.g. blank `startup`
    # and `split`); using bare `.strip()` would eat those trailing `\t`s and
    # leave the row short of `len(FZF_ROW_FIELDS)`.
    choice = proc.stdout.rstrip("\n")
    if not choice:
        return 1
    payload = EntryPayload.from_fzf_row(choice)
    if fresh is not None and cached is not None and choice in cached.rows:
        # Picked from the cached rows: act on the row as it is now. A row
        # they never had (a view key, ctrl-g's crew agents) came from a
        # reload and is fresh already; the opening view may not hold it.
        found = fresh.choice(choice)
        if found is None:
            name = payload.session_name or payload.path or "that row"
            report_failure(f"{name}: gone since the picker opened")
            return 1
        payload = found
    if payload.kind == "agent":
        return connect_agent(payload)
    return connect_resolved(
        payload.session_name,
        payload.path,
        payload.startup,
        payload.split,
        derived_name=payload.kind in {"zoxide", "find"},
    )


def proven_here(here: str, socket: str) -> bool:
    """A row's server proof still holds: the socket it was made against is
    still the one tsesh's own calls reach."""
    return bool(here and socket and own_socket() == socket)


def connect_agent(payload: EntryPayload) -> int:
    """Take the user to an agent's pane.

    A pane on this tmux server is selected here (pane ids are unique only per
    server) and the client moved to it, when the client is on that server too.
    Anything else, such as a remote host, a private tmux server, or a picker
    run outside tmux, is murmur's to reach: ``murmur jump``.
    """
    if (
        proven_here(payload.here, payload.socket)
        and inside_own_server()
        and payload.pane
    ):
        # Pinned: the calls below name the proven socket itself, so an alias
        # retargeted after this check cannot redirect them.
        with pinned_server(payload.socket):
            tmux_cmd("select-window", "-t", payload.pane)
            tmux_cmd("select-pane", "-t", payload.pane)
            backend().switch(payload.session_name, target=payload.pane)
        return 0
    exe = murmur_command()
    if exe is None or not payload.jump_target:
        print("agent: murmur is needed to reach this agent", file=sys.stderr)
        return 1
    # stdio stays inherited: jump may need the tty (ssh, a hardware-key tap).
    code = subprocess.run([exe, "jump", payload.jump_target], check=False).returncode
    if code != 0:
        report_failure(f"murmur jump {payload.jump_target} failed (exit {code})")
        return 1
    return 0


def update_last(name: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LAST_FILE.write_text(name + "\n")


class LiveSessions(dict[str, AgentState | None]):
    """Live session -> state, plus the sessions some client has attached
    and each session's id."""

    attached: frozenset[str] = frozenset()

    def __init__(self) -> None:
        super().__init__()
        self.ids: dict[str, str] = {}  # name -> tmux session id ($N)
        self.paths: dict[str, str] = {}  # name -> #{session_path}
        self.activity: dict[str, int] = {}  # name -> #{session_activity}
        # name -> (active, panes, cwd of the active pane), one per window
        self.windows: dict[str, list[tuple[bool, int, str]]] = {}

    def location(self, name: str) -> tuple[str, int]:
        """Where session NAME is: its active window's cwd, and how many other
        directories its windows sit in."""
        windows = self.windows.get(name, [])
        here = next((cwd for active, _, cwd in windows if active), "")
        here = here or self.paths.get(name, "")
        others = {os.path.realpath(cwd) for _, _, cwd in windows if cwd}
        others.discard(os.path.realpath(here) if here else "")
        return here, len(others)

    def counts(self, name: str) -> str:
        """counts_cell for session NAME, or "" when its windows are unknown."""
        windows = self.windows.get(name, [])
        if not windows:
            return ""
        return counts_cell(len(windows), sum(panes for _, panes, _ in windows))

    def dirs(self) -> set[str]:
        """Every directory a live session is rooted at or has a window in."""
        found = {p for p in self.paths.values() if p}
        found |= {cwd for ws in self.windows.values() for _, _, cwd in ws if cwd}
        return {os.path.realpath(p) for p in found}


class TmuxBackend:
    """tmux sessions. A class so tests can stub one method at a time."""

    def live_sessions(self) -> dict[str, AgentState | None]:
        return self.snapshot() or {}

    def snapshot(self) -> LiveSessions | None:
        """Live session -> strongest murmur state, sessions and windows in one
        tmux call.

        None when no server runs, so a caller can start one and ask again.
        """
        # Two lines per session: its fields, then its path, each keyed by the
        # session id; then one line per window, keyed the same way. The two
        # commands run back to back in the server, so they see one state.
        # Free text (name, path) comes last on its line.
        result = tmux_cmd(
            "list-sessions",
            "-F",
            "#{session_attached}\t#{session_id}\t#{@murmur_session_state}"
            "\t#{session_activity}\t#{session_name}"
            "\n#{session_id}\tP\t#{session_path}",
            ";",
            "list-windows",
            "-a",
            "-F",
            "#{session_id}\tW\t#{window_active}\t#{window_panes}\t#{pane_current_path}",
            check=False,
        )
        if result.returncode != 0:
            return None
        live = LiveSessions()
        attached: set[str] = set()
        names: dict[str, str] = {}  # id -> name
        paths: dict[str, str] = {}
        window_line = re.compile(r"(\$[0-9]+)\tW\t([01])\t([0-9]+)\t(.*)")
        windows: list[re.Match[str]] = []
        for line in result.stdout.splitlines():
            if m := re.fullmatch(r"(\$[0-9]+)\tP\t(.*)", line):
                paths[m[1]] = m[2]
                continue
            if m := window_line.fullmatch(line):
                windows.append(m)
                continue
            fields = [*line.split("\t", 4), "", "", "", ""]
            clients, sid, raw, activity, name = fields[:5]
            if name.strip() and re.fullmatch(r"\$[0-9]+", sid):
                live[name] = AgentState.parse(raw)
                live.ids[name] = sid
                live.activity[name] = int(activity) if activity.isdigit() else 0
                names[sid] = name
                if clients not in {"", "0"}:
                    attached.add(name)
        live.attached = frozenset(attached)
        live.paths = {names[sid]: path for sid, path in paths.items() if sid in names}
        for m in windows:
            if m[1] in names:
                window = (m[2] == "1", int(m[3]), m[4])
                live.windows.setdefault(names[m[1]], []).append(window)
        return live

    def exists(self, name: str) -> bool:
        return (
            tmux_cmd(
                "has-session",
                "-t",
                exact_session_target(name),
                check=False,
                capture=True,
            ).returncode
            == 0
        )

    def switch(self, name: str, target: str | None = None) -> None:
        """Switch to NAME, or to TARGET (a session id) when the caller has one.

        An id is the only unambiguous target: ``=$0`` means id $0, even when a
        session is literally named "$0".
        """
        target = target or exact_session_target(name)
        if os.environ.get("TMUX"):
            # The client that opened the picker, not whichever tmux calls
            # current (a popup has no pane of its own).
            client = ["-c", INVOKING_CLIENT] if INVOKING_CLIENT else []
            tmux_cmd("switch-client", *client, "-t", target, capture=False)
        else:
            tmux_cmd("attach-session", "-t", target, capture=False)
        update_last(name)

    def ensure_server(self) -> None:
        """Start the server if none runs, so a restoring tmux can bring back
        its saved sessions before they are listed.

        Plain tmux has nothing to restore: ``start-server`` with no sessions
        exits at once (exit-empty) and the picker lists nothing, as before.
        """
        if server_running():
            return
        start = ("start-server",)
        if not start_server_in_own_scope(start):
            tmux_cmd(*start, check=False)

    def create(
        self, name: str, path: str, startup: str | None, split: str = ""
    ) -> None:
        # realpath: session_path then names the directory, not a symlink that
        # may later point elsewhere (see live_session_for_path).
        # "#" is escaped: tmux format-expands -c.
        start_dir = os.path.realpath(path).replace("#", "##")
        new_session = ("new-session", "-d", "-s", name, "-c", start_dir)
        if not server_running():
            # Starting the server may restore NAME; new-session would then
            # fail with "duplicate session". Start it first, then look again.
            self.ensure_server()
            if self.exists(name):
                return
        if server_running():
            tmux_cmd(*new_session, capture=False)
        elif not start_server_in_own_scope(new_session):
            # The server exited again (nothing restored): start it with the
            # session, in its own scope when that applies.
            tmux_cmd(*new_session, capture=False)
        if startup:
            tmux_cmd(
                "send-keys",
                "-t",
                active_pane_target(name),
                startup,
                "C-m",
                capture=False,
            )
        if split in ("vertical", "horizontal"):
            tmux_cmd(
                "split-window",
                "-h" if split == "vertical" else "-v",
                "-t",
                active_pane_target(name),
                "-c",
                path,
                capture=False,
            )

    def last_candidates(self) -> list[str]:
        result = tmux_cmd(
            "display-message", "-p", "#{client_last_session}", check=False
        )
        if result.returncode != 0:
            return []
        name = result.stdout.strip()
        return [name] if name else []

    def current_cwd(self, ref: str) -> str:
        return pane_cwd(ref)


BACKEND = TmuxBackend()


def backend() -> TmuxBackend:
    return BACKEND


def connect_resolved(
    session_name: str,
    path: str | None,
    startup: str | None,
    split: str = DEFAULT_SPLIT,
    *,
    derived_name: bool = False,
) -> int:
    """Switch to SESSION_NAME, creating it at PATH if needed.

    ``derived_name`` marks a name computed from PATH (not a configured or live
    session's own name): it may collide with another directory's session, so
    it gets a suffix then.
    """
    if derived_name and path:
        if live := live_session_for_path(path):
            backend().switch(live.name, target=live.id)
            return 0
        session_name = free_name_for_path(session_name)
    if backend().exists(session_name):
        backend().switch(session_name)
        return 0

    if path is None:
        print(f"No such session or path: {session_name}", file=sys.stderr)
        return 1

    backend().create(session_name, path, startup, split)
    backend().switch(session_name)
    return 0


def pane_cwd(pane_id: str) -> str:
    """Read a pane's cwd from tmux instead of taking it on a command line.

    SECURITY: the key binding that reaches here runs under ``run-shell``,
    which format-expands its argument and hands the result to ``sh -c``.
    Interpolating ``#{pane_current_path}`` there is command injection --
    a directory whose name contains a newline splits the shell line and
    the second line runs as a command. ``#{pane_id}`` is minted by tmux
    (``%[0-9]+``) and is the only value safe to interpolate, so the
    binding passes that and we fetch the path over a pipe.
    """
    result = tmux_bytes("display-message", "-p", "-t", pane_id, "#{pane_current_path}")
    if result.returncode != 0:
        return ""
    return os.fsdecode(result.stdout).removesuffix("\n")


@dataclass(frozen=True)
class LiveSession:
    id: str  # "$N": the only target that cannot alias another session's name
    name: str


def format_escape(text: str) -> str:
    """Escape TEXT as a literal inside a tmux format conditional."""
    return text.replace("#", "##").replace(",", "#,").replace("}", "#}")


def live_session_for_path(path: str) -> LiveSession | None:
    """The live session rooted at PATH, if any.

    tmux does the comparison (``list-sessions -f``) and we read only session
    ids: a path may hold any byte, including our own record separators, so it
    is never parsed out of tmux output. Two spellings match: the realpath
    (what tsesh creates sessions with) and the path as given (what older tsesh
    stored, possibly through a symlink).

    Accepted limitation: a symlink retargeted after its session was created
    still reaches that session when connected through the same symlink string.
    The real path is always exact.
    """
    given = os.path.expanduser(path)
    if not os.path.isabs(given):
        given = os.path.join(os.getcwd(), given)
    wanted = {os.path.realpath(given), given}
    clauses = [f"#{{==:#{{session_path}},{format_escape(p)}}}" for p in sorted(wanted)]
    condition = clauses[0] if len(clauses) == 1 else f"#{{||:{','.join(clauses)}}}"
    found = tmux_cmd(
        "list-sessions", "-f", condition, "-F", "#{session_id}", check=False
    )
    ids = found.stdout.split()
    if found.returncode != 0 or not ids:
        return None
    name = tmux_bytes("display-message", "-p", "-t", ids[0], "#{session_name}")
    return LiveSession(ids[0], os.fsdecode(name.stdout).removesuffix("\n"))


def free_name_for_path(name: str) -> str:
    """NAME, or NAME-2, NAME-3... when sanitizing made it collide.

    Sanitizing maps distinct paths (``a.b`` and ``a_b``) to one name. Callers
    look the directory's own session up first (live_session_for_path).
    """
    candidate, n = name, 1
    while backend().exists(candidate):
        n += 1
        candidate = f"{name}-{n}"
    return candidate


def connect(target: str) -> int:
    target = expand(target)
    sessions_by_name = {session.name: session for session in load_config().sessions}
    session = sessions_by_name.get(target)
    if session:
        return connect_resolved(
            session.name,
            expand(session.path),
            session.startup,
            session.split,
        )
    # If `target` already names a live tmux session, attach to it directly.
    # Without this, a bare session name that also happens to be a directory
    # in the current pane's CWD (e.g. `foot` while sitting in
    # ~/dotfiles, where stow packages mirror live session names) gets mangled
    # into `dotfiles/foot` by session_name_for_path below, and a new
    # session is spawned instead of switching to the running one.
    if backend().exists(target):
        return connect_resolved(target, None, None, DEFAULT_SPLIT)
    # Either a real path (create/attach a session rooted there) or a bare
    # session name (attach if it exists, error otherwise — connect_resolved
    # handles both via its `path is None` branch).
    path = target if Path(target).exists() else None
    name = session_name_for_path(target) if path else target
    return connect_resolved(name, path, None, DEFAULT_SPLIT, derived_name=True)


def kill(kind: str, session_id: str, client: str = "") -> int:
    """Kill the session with tmux id SESSION_ID (``$N``), from a picker row
    of KIND.

    Only live session rows carry an id, so any other row is a no-op. A name
    is no target: ``=$0`` means id $0 and ``=a.b`` means window b. The
    session the invoking client is attached to is refused with a message.
    """
    if kind not in ("default", "tmux") or not re.fullmatch(r"\$[0-9]+", session_id):
        return 0
    mark_switched()  # its reload follows; the handover must not undo it
    listed = tmux_bytes("list-sessions", "-F", "#{session_id}\t#{session_name}")
    names = dict(
        line.partition("\t")[::2] for line in os.fsdecode(listed.stdout).splitlines()
    )
    if session_id not in names:
        return 0
    client = resolve_invoker(client)[0] or ""
    if client:
        out = tmux_bytes("list-clients", "-F", "#{client_name}\t#{session_id}")
        for line in os.fsdecode(out.stdout).splitlines():
            cname, _, current = line.partition("\t")
            if cname == client and current == session_id:
                tmux_cmd(
                    "display-message",
                    "-c",
                    client,
                    "-d",
                    "5000",
                    f"tsesh: not killing the current session ({names[session_id]})",
                    check=False,
                )
                return 0
    tmux_cmd("kill-session", "-t", session_id, check=False)
    return 0


def last() -> int:
    # `tsesh last` is typically bound to a hotkey (prefix-L). When the
    # last-known session has been killed, the right behavior is a silent
    # no-op — not respawning a configured session from scratch (which is
    # what `connect()` would do for a configured name) and not erroring
    # with "No such session or path" for an unconfigured one.
    #
    # We collect both pointers (the backend's own notion of "last", then our
    # LAST_FILE) and switch to the first that's still live. If none are,
    # exit 0 (with a tmux message when inside tmux).
    candidates: list[str] = list(backend().last_candidates())
    if LAST_FILE.exists():
        name = LAST_FILE.read_text().strip()
        if name and name not in candidates:
            candidates.append(name)
    for name in candidates:
        if backend().exists(name):
            backend().switch(name)
            return 0
    if os.environ.get("TMUX"):
        tmux_cmd("display-message", "tsesh: no previous session", check=False)
    return 0


MODES = ["all", "sessions", "find", "agents"]


# The tmux client the picker was opened from; failures are shown on it, not on
# whichever client tmux considers current.
INVOKING_CLIENT: str | None = None


def valid_client_name(name: str) -> bool:
    """A tty path or "client-N": safe as a -t/-c target, nothing to split."""
    return bool(name) and re.fullmatch(r"[A-Za-z0-9_./:@-]+", name) is not None


def resolve_invoker(given: str = "") -> tuple[str | None, str, str]:
    """(client, pane id, session name) of whoever opened the picker, with one
    ``display-message`` before fzf starts. The client is the one the key
    binding named, else (in tmux) the one tmux reports now. The pane and
    session are read only from a client of tsesh's own server; in a popup
    $TMUX_PANE is unset, so they come from the client itself."""
    client = given if valid_client_name(given) else None
    inside = inside_own_server()
    if client and not inside:
        return client, "", ""
    if not client and not os.environ.get("TMUX"):
        return None, "", ""
    where = "#{pane_id}\t#{session_name}" if inside else ""
    if client:
        result = tmux_bytes("display-message", "-p", "-t", client, where)
        fields = [client]
    else:
        # In a pane (not a popup) $TMUX_PANE is where the picker runs. Asked
        # of the server the client is on; inside, that is tsesh's own.
        own_pane = os.environ.get("TMUX_PANE", "")
        target = ["-t", own_pane] if inside and _is_pane_id(own_pane) else []
        result = client_tmux(
            "display-message", "-p", *target, f"#{{client_name}}\t{where}"
        )
        fields = []
    text = (
        os.fsdecode(result.stdout).removesuffix("\n") if result.returncode == 0 else ""
    )
    fields += text.split("\t", 2 - len(fields))
    name, pane, session = [*fields, "", "", ""][:3]
    if not _is_pane_id(pane):
        pane, session = "", ""
    return name or None, pane, session


def client_tmux(*args: str) -> subprocess.CompletedProcess[bytes]:
    """tmux on the server the invoking client is on: the socket in $TMUX.

    Never the TSESH_TMUX_SOCKET_* override or a pinned socket: a client name
    only means something on its own server.
    """
    socket = os.environ.get("TMUX", "").split(",")[0]
    return subprocess.run(
        ["tmux", *(["-S", socket] if socket else []), *args],
        check=False,
        capture_output=True,
    )


def report_failure(message: str) -> None:
    """Make a failure readable after a popup closes: stderr, a tmux message on
    the invoking client when in tmux, and a short pause on a tty."""
    print(message, file=sys.stderr)
    if os.environ.get("TMUX"):
        target = ["-c", INVOKING_CLIENT] if INVOKING_CLIENT else []
        client_tmux("display-message", *target, "-d", "5000", message)
    pause_for_error()


def pause_for_error() -> None:
    """display-popup -E closes on exit; leave the message readable."""
    if sys.stderr.isatty():
        time.sleep(2)


def main(argv: Iterable[str] | None = None) -> int:
    try:
        parser = argparse.ArgumentParser(
            prog="tsesh",
            description="tmux session picker: pinned and live sessions, zoxide,"
            " a directory scan and, with murmur, coding agents.",
        )
        parser.add_argument("--version", action="version", version=f"tsesh {VERSION}")
        # fzf-action, fzf-enter and preview serve the picker's own bindings;
        # they work but are left out of the list.
        sub = parser.add_subparsers(
            dest="cmd",
            required=True,
            metavar="{pick-and-connect,picker,list,connect,last,kill}",
        )
        views = "view: all (default), sessions, find or agents"

        p_pick_connect = sub.add_parser(
            "pick-and-connect",
            help="open the picker and switch to the chosen row",
            description="Open the picker; Enter switches to the session (creating"
            " it in its directory if needed) or jumps to the agent.",
        )
        p_pick_connect.add_argument("--mode", choices=MODES, default="all", help=views)
        p_pick_connect.add_argument("--query", default="", help="initial query")
        p_pick_connect.add_argument(
            "--client",
            default="",
            help="tmux client the picker was opened from; messages and the"
            " switch go to it (the tsesh.tmux keys pass it)",
        )

        p_pick = sub.add_parser(
            "picker", help="open the picker and print the chosen row"
        )
        p_pick.add_argument("--mode", choices=MODES, default="all", help=views)
        p_pick.add_argument("--query", default="", help="initial query")

        p_list = sub.add_parser("list", help="print the picker's rows")
        p_list.add_argument("--mode", choices=MODES, default="all", help=views)
        p_list.add_argument(
            "--crew", action="store_true", help="include orchestrated agents"
        )
        p_list.add_argument("--prompt", default="", help=argparse.SUPPRESS)

        p_connect = sub.add_parser(
            "connect",
            help="switch to a session or directory",
            description="Switch to TARGET: a pinned or live session name, or a"
            " directory (its live session, else a new one rooted there).",
        )
        p_connect.add_argument("target", nargs="?", default="")
        p_connect.add_argument(
            "--pane",
            default="",
            help="use this tmux pane's directory as the target (prefix T)",
        )

        sub.add_parser(
            "last", help="switch to the previous session, if it is still live"
        )

        p_kill = sub.add_parser(
            "kill",
            help="kill a live session by id (ctrl-x in the picker)",
            description="Kill the live session with tmux id --session-id ($N)."
            " Only --kind=tmux or default rows count, and never the session"
            " --client is in.",
        )
        p_kill.add_argument("--kind", default="", help="the row's kind")
        p_kill.add_argument("--session-id", default="", help="tmux session id, $N")
        p_kill.add_argument(
            "--client", default="", help="tmux client the picker was opened from"
        )

        # fzf's transform bindings for the view keys and Enter; not for people.
        p_action = sub.add_parser("fzf-action")
        p_action.add_argument("view", choices=[*MODES, "current"])
        sub.add_parser("fzf-enter")

        p_preview = sub.add_parser("preview")
        p_preview.add_argument("--kind", default="")
        p_preview.add_argument("--session-name", default="")
        p_preview.add_argument("--path", default="")
        p_preview.add_argument("--split", default=DEFAULT_SPLIT)
        p_preview.add_argument("--host", default="")
        p_preview.add_argument("--pane", default="")
        p_preview.add_argument("--here", default="")
        p_preview.add_argument("--socket", default="")

        args = parser.parse_args(list(argv) if argv is not None else None)
        pin_own_server()
        set_layout(terminal_columns())

        if args.cmd == "list":
            mode, crew = args.mode, args.crew
            if args.prompt:
                mode, crew = prompt_state(args.prompt)
            return print_entries(mode, crew)
        if args.cmd == "fzf-action":
            return fzf_action(args.view)
        if args.cmd == "fzf-enter":
            return fzf_enter()
        if args.cmd == "kill":
            return kill(
                row_unescape(args.kind), row_unescape(args.session_id), args.client
            )
        if args.cmd == "picker":
            return fzf(args.mode, query=args.query)
        if args.cmd == "pick-and-connect":
            return pick_and_connect(args.mode, query=args.query, client=args.client)
        if args.cmd == "connect":
            target = backend().current_cwd(args.pane) if args.pane else args.target
            if not target:
                print("connect: no target", file=sys.stderr)
                return 1
            return connect(target)
        if args.cmd == "preview":
            # fzf hands over the row's fields still escaped.
            return preview(
                *map(
                    row_unescape,
                    (
                        args.path,
                        args.session_name,
                        args.kind,
                        args.split,
                        args.host,
                        args.pane,
                        args.here,
                        args.socket,
                    ),
                )
            )
        if args.cmd == "last":
            return last()
        return 1
    except ConfigError as exc:
        print(exc, file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or "").strip()
        report_failure(detail or f"tmux failed: {exc}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
