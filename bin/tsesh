# Bumped by hand at release time; see RELEASING.md.
VERSION = "1.0.2"


class AgentState(enum.IntEnum):
    """Agent states as murmur publishes them, ordered by urgency.

    tsesh reads one tmux option per session, ``@murmur_session_state``, which
    murmur keeps at the strongest non-idle state across the session's panes.
    Without murmur the option is unset and every row has no state.
    """

    idle = 0  # counted in a session's breakdown; the option never yields it
    waiting = 1
    working = 2
    done = 3
    blocked = 4
    error = 5
    crashed = 6

    @classmethod
    def parse(cls, raw: str) -> AgentState | None:
        try:
            state = cls[raw]
        except KeyError:
            return None
        # An idle session shows no state, as before; only counts mention idle.
        return None if state is cls.idle else state


# THEME BEGIN: tsesh-state-glyphs
# Nerd Font glyphs, the same shapes murmur's dash uses per state.
STATE_GLYPH: dict[AgentState, str] = {
    AgentState.crashed: "\uf057",  # fa-times-circle
    AgentState.error: "\uf071",  # fa-exclamation-triangle
    AgentState.blocked: "\uf075",  # fa-comment
    AgentState.done: "\uf058",  # fa-check-circle
    AgentState.working: "\uf04b",  # fa-play
    AgentState.waiting: "\uf252",  # fa-hourglass-half
    AgentState.idle: "\uf186",  # fa-moon-o
}
# THEME END: tsesh-state-glyphs

ATTENTION_STATES = frozenset({AgentState.blocked, AgentState.error, AgentState.crashed})


# While set, every tmux call names this exact socket instead of following an
# alias ($TMUX, a symlink) that could be retargeted after a proof was made.
PINNED_SOCKET: str | None = None


@contextlib.contextmanager
def pinned_server(socket: str) -> Generator[None, None, None]:
    global PINNED_SOCKET
    previous, PINNED_SOCKET = PINNED_SOCKET, socket
    try:
        yield
    finally:
        PINNED_SOCKET = previous


def tmux_socket_args() -> tuple[str, ...]:
    """``-S``/``-L`` args for an isolated server; empty for the default.

    ``TSESH_TMUX_SOCKET_PATH`` and ``TSESH_TMUX_SOCKET_NAME`` exist for tests.
    """
    if PINNED_SOCKET:
        return ("-S", PINNED_SOCKET)
    if path := os.environ.get("TSESH_TMUX_SOCKET_PATH"):
        return ("-S", path)
    if name := os.environ.get("TSESH_TMUX_SOCKET_NAME"):
        return ("-L", name)
    return ()


def tmux_cmd(
    *args: str, check: bool = True, capture: bool = True
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["tmux", *tmux_socket_args(), *args],
        check=check,
        text=True,
        capture_output=capture,
    )


def tmux_bytes(*args: str) -> subprocess.CompletedProcess[bytes]:
    """tmux output as bytes: text mode turns a CR in a path into a newline."""
    return subprocess.run(
        ["tmux", *tmux_socket_args(), *args], check=False, capture_output=True
    )


def server_running() -> bool:
    return tmux_cmd("list-sessions", check=False).returncode == 0


def systemd_cgroup(proc_cgroup: str) -> str:
    """The systemd cgroup path from ``/proc/<pid>/cgroup`` text, or "".

    Hybrid hosts track units in the ``name=systemd`` v1 hierarchy; pure v2
    hosts have only the ``0::`` line.
    """
    paths = dict(
        line.split(":", 2)[1:]
        for line in proc_cgroup.splitlines()
        if line.count(":") >= 2
    )
    return paths.get("name=systemd", paths.get("", ""))


def in_user_manager(proc_cgroup: str) -> bool:
    """True when the cgroup belongs to a unit of the user's systemd manager.

    That is where a server inherits a service's lifetime, e.g. a shell in a
    ``foot --server`` window. A login shell (ssh, tty) sits in logind's
    ``session-N.scope`` instead, which survives logout as an abandoned scope
    while ``user@UID.service`` is stopped once the last session ends, so a
    server started there must stay put.
    """
    return "/user@" in systemd_cgroup(proc_cgroup)


def start_server_in_own_scope(new_session: tuple[str, ...]) -> bool:
    """Start the tmux server in its own systemd scope; False if not done.

    The server forks off whoever ran ``tmux`` and stays in that process's
    cgroup. Under a user service, stopping or restarting that service kills
    every session; a transient scope gives the server its own cgroup. Outside
    the user manager (macOS, ssh and tty logins, containers) or when
    systemd-run fails, this returns False and the caller runs plain tmux.
    """
    try:
        proc_cgroup = Path("/proc/self/cgroup").read_text()
    except OSError:
        return False
    if not (in_user_manager(proc_cgroup) and shutil.which("systemd-run")):
        return False
    # No expansion: tmux must get session names and paths containing "$"
    # verbatim. systemd < 254 rejects the flag and we fall back.
    cmd = ("systemd-run", "--user", "--scope", "--quiet", "--collect")
    result = subprocess.run(
        [*cmd, "--expand-environment=no", "tmux", *tmux_socket_args(), *new_session],
        check=False,
        capture_output=True,
    )
    return result.returncode == 0


# Room for three "glyph+count" groups; the header and every row share it.
STATE_WIDTH = 11
# Window and pane counts of a live session ("3w 5p").
COUNTS_WIDTH = 7
# Agents view columns after the label.
STREAM_WIDTH = 16
HOST_WIDTH = 12
AGE_WIDTH = 4
# Every row starts with a marker, an icon (or state glyph) and a space.
PREFIX_WIDTH = 3


def cell_width(text: str) -> int:
    """Terminal cells TEXT takes: wide (CJK) characters two, combining marks
    and zero-width characters none."""
    width = 0
    for ch in text:
        if unicodedata.combining(ch) or unicodedata.category(ch) in {"Cf", "Mn", "Me"}:
            continue
        width += 2 if unicodedata.east_asian_width(ch) in {"W", "F"} else 1
    return width


def fit(text: str, width: int, *, keep: str = "end") -> str:
    """TEXT in exactly WIDTH cells: padded, or cut with an ellipsis.

    KEEP says what survives a cut: the start ("end": cut the end), the tail
    ("start": cut the start, for paths), or both ends of a slash-separated
    name ("middle": projects/…/demo).
    """
    if width <= 0:
        return ""
    if cell_width(text) <= width:
        return text + " " * (width - cell_width(text))
    if keep == "middle" and "/" in text:
        # The leaf (last component) is what tells sessions apart: keep it
        # whole and shorten the start; only a leaf too long for the column
        # is cut itself.
        leaf = text.rsplit("/", 1)[1]
        room = width - cell_width(leaf) - 2  # "…/"
        if room < 1:
            return fit(leaf, width)
        head = ""
        for ch in text:
            if cell_width(head + ch) > room:
                break
            head += ch
        return fit(f"{head}\u2026/{leaf}", width)
    if keep == "start":
        out = ""
        for ch in reversed(text):
            if cell_width(ch + out) > width - 1:
                break
            out = ch + out
        return fit("\u2026" + out, width)
    out = ""
    for ch in text:
        if cell_width(out + ch) > width - 1:
            break
        out += ch
    return fit(out + "\u2026", width)


@dataclass(frozen=True)
class Layout:
    """Column plan for one terminal width. Rows and header both use it.

    The list gets what the preview leaves: the preview sits right of the list
    on wide screens, below it under 120 columns, and starts hidden (ctrl-/
    shows it) under 80. The name column grows from 16 to 40 cells; on narrow
    lists the counts column goes first, then the path; the state cell shrinks
    to the strongest groups.
    """

    columns: int

    @property
    def preview(self) -> str:
        if self.columns >= 120:
            return "right"
        return "down" if self.columns >= 80 else "hidden"

    @property
    def preview_window(self) -> str:
        return {
            "right": "right,55%,border-left",
            "down": "down,45%,border-top",
            "hidden": "down,45%,border-top,hidden",
        }[self.preview]

    @property
    def row_width(self) -> int:
        """Cells a row may take: the list's width less fzf's pointer gutter
        and scrollbar, and its border and padding outside a popup."""
        listed = self.columns
        if self.preview == "right":
            listed -= math.ceil(self.columns * 0.55) + 1
        margin = 5 + (4 if fzf_border() == "rounded" else 0)
        return max(listed - margin, 20)

    @property
    def name_width(self) -> int:
        return min(max(int(self.row_width * 0.35), 16), 40)

    @property
    def _rest(self) -> int:
        return self.row_width - PREFIX_WIDTH - self.name_width - 1

    @property
    def state_width(self) -> int:
        wide = STATE_WIDTH + 1 + COUNTS_WIDTH + 1 + 12
        return STATE_WIDTH if self._rest >= wide else 5

    @property
    def show_counts(self) -> bool:
        return self._rest - self.state_width - 1 >= COUNTS_WIDTH + 1 + 12

    @property
    def path_width(self) -> int:
        """Cells for the path (and its "+N" note); 0 drops the column."""
        width = self._rest - self.state_width - 1
        width -= (COUNTS_WIDTH + 1) * self.show_counts
        return width if width >= 8 else 0

    def agent_columns(self, stream: bool, host: bool) -> tuple[bool, bool]:
        """Which of the agents view's stream and host columns fit; the host
        column goes first."""
        room = self._rest - AGE_WIDTH
        if stream and host and room < STREAM_WIDTH + HOST_WIDTH + 2:
            host = False
        if stream and room < STREAM_WIDTH + 1 + (HOST_WIDTH + 1) * host:
            stream = False
        if host and room < HOST_WIDTH + 1:
            host = False
        return stream, host


def terminal_columns() -> int:
    """fzf's width for reloads and previews ($FZF_COLUMNS), else the
    terminal's (the popup's, before fzf starts)."""
    with contextlib.suppress(KeyError, ValueError):
        return int(os.environ["FZF_COLUMNS"])
    return shutil.get_terminal_size((160, 40)).columns


LAYOUT = Layout(160)


def set_layout(columns: int) -> None:
    global LAYOUT
    LAYOUT = Layout(columns)


